{
  "name": "dshremote-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Remote 桥插件：监听 DSH 的回合结束事件并推送给手机，同时把 DSH Web 反代到局域网端口。",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9"
  },
  "license": "MIT"
}
